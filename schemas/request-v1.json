{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/casterchenai/OpenAgent-secretbox/schemas/request-v1.json",
  "title": "OpenAgent SecretBox request",
  "description": "Version 1 metadata for a secret intake request. Secret values are never part of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "title",
    "needs"
  ],
  "properties": {
    "schema_version": {
      "oneOf": [
        {
          "type": "integer",
          "const": 1
        },
        {
          "type": "string",
          "const": "1"
        }
      ],
      "description": "Optional for backwards compatibility; omitted values are interpreted as version 1."
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Client supplied label. SecretBox generates a separate server-side request id."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "allowed_targets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/targetPattern"
      }
    },
    "forbidden_targets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/targetPattern"
      }
    },
    "write_policy": {
      "$ref": "#/$defs/writePolicy"
    }
  },
  "$defs": {
    "targetPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)(?!\\.$)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*|/|$))(?!.*[. ](?:/|$)).+$"
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "env",
            "file",
            "env_file"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "target": {
          "$ref": "#/$defs/targetPattern"
        },
        "default_value": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
          "description": "Non-secret compatibility metadata only. Secret values are forbidden in request documents."
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "env"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
              },
              "target": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "file",
                  "env_file"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "default_value": false
            }
          }
        }
      ]
    },
    "writePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env_file": {
          "$ref": "#/$defs/targetPattern"
        },
        "mode": {
          "const": "merge_only"
        },
        "no_overwrite": {
          "type": "boolean"
        },
        "backup": {
          "type": "boolean"
        },
        "backup_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "max_file_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      }
    }
  }
}
