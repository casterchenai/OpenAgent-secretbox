{
  "schema_version": 1,
  "request_id": "anthropic-local-setup",
  "title": "Anthropic API setup",
  "workspace_root": "/path/to/project",
  "needs": [
    {
      "type": "env",
      "name": "ANTHROPIC_API_KEY",
      "required": true,
      "description": "Anthropic API key"
    }
  ],
  "write_policy": {
    "env_file": ".env.local",
    "mode": "merge_only",
    "no_overwrite": true,
    "backup": false
  }
}
